@inherits LayoutComponentBase

<RadzenComponents @rendermode="InteractiveServer" />

<RadzenLayout Style="height: 100vh; display: flex; flex-direction: column;">

    <Header @bind-SidebarExpanded="_sidebarExpanded" />

    <div style="display: flex; flex: 1; overflow: hidden;">

        <div style="width: 300px; background: #1a237e; color: #fff; flex-shrink: 0; padding: 1rem;">
            @* Здесь будет Sidebar *@
        </div>

        <div style="width: 100%; height: 100%; padding: 10px; overflow: auto;">
            @Body
        </div>

    </div>

    <Footer />

</RadzenLayout>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool _sidebarExpanded = true;
}
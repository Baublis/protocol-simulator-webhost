@using Orientation = Radzen.Orientation

<RadzenStack Gap="1rem" Style="min-width: 350px; padding: 0.5rem;">
    
    <!-- Заголовок -->
    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center">
        <RadzenIcon Icon="@Icon" IconStyle="IconStyle.Warning" Style="font-size: 28px; color:" />
        <RadzenLabel Style="font-size: 1.2rem; font-weight: 600;">
            @Title
        </RadzenLabel>
    </RadzenStack>

    <!-- Сообщение -->
    <RadzenText Style="margin: 0.5rem 0; line-height: 1.5;">
        @Message
    </RadzenText>

    <!-- Кнопки -->
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="margin-top: 1rem;">
        <RadzenButton Click="OnConfirmHandler" 
                      ButtonStyle="@ConfirmButtonStyle" 
                      Icon="@ConfirmIcon">
            @ConfirmText
        </RadzenButton>
        <RadzenButton Click="OnCancelHandler" 
                      ButtonStyle="ButtonStyle.Secondary" 
                      Icon="close">
            @CancelText
        </RadzenButton>
    </RadzenStack>

</RadzenStack>

@code {
    [Parameter] public string Title { get; set; } = "Подтверждение";
    [Parameter] public string Message { get; set; } = "Вы уверены?";
    [Parameter] public string Icon { get; set; } = "help";
    [Parameter] public string IconColor { get; set; } = "var(--rz-warning)";
    [Parameter] public string ConfirmText { get; set; } = "Да";
    [Parameter] public string ConfirmIcon { get; set; } = "check";
    [Parameter] public ButtonStyle ConfirmButtonStyle { get; set; } = ButtonStyle.Danger;
    [Parameter] public string CancelText { get; set; } = "Нет";
    
    [Parameter] public EventCallback OnConfirm { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private async Task OnConfirmHandler() => await OnConfirm.InvokeAsync();
    private async Task OnCancelHandler() => await OnCancel.InvokeAsync();
}
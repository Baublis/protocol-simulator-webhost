@using Orientation = Radzen.Orientation

@inject DialogService DialogService

<RadzenStack Gap="1rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
    <RadzenTemplateForm TItem="NodeStateModel" Data="VariableModel" Submit="AddVariable">
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenStack Gap="0" Visible="false">
                    <RadzenLabel>
                        Имя переменной
                    </RadzenLabel>
                    <RadzenFormField>
                        <ChildContent>
                            <RadzenTextBox Name="Name" @bind-Value="@VariableModel.Name" Disabled="@IsLoading" />
                        </ChildContent>
                        <Helper>
                            <RadzenRequiredValidator Component="Name" Text="Имя переменной обязательно" />
                        </Helper>
                    </RadzenFormField>
                </RadzenStack>
                <RadzenStack Gap="0">
                    <RadzenLabel>
                        Количество
                    </RadzenLabel>
                    <RadzenFormField>
                        <RadzenNumeric @bind-Value="@VariableModel.CloneCount" Min="1" Max="20000" Style="@OPC_STYLE" Disabled="@IsLoading" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenStack Gap="0">
                    <RadzenLabel>
                        Тип переменной
                    </RadzenLabel>
                    <RadzenFormField>
                        <RadzenDropDown TValue="Type" Value="@VariableModel.VariableType" TextProperty="@nameof(Type.Name)" Data="@DataTypes"
                                        ValueChanged="@(value => VariableModel.VariableType = value)" Disabled="@IsLoading" />
                    </RadzenFormField>
                </RadzenStack>
                <RadzenStack Gap="0">
                    <RadzenLabel>
                        Значение переменной
                    </RadzenLabel>
                    <RadzenFormField>
                        <ChildContent>
                            @{
                                if (VariableModel.VariableType == SimulatorDataTypes.Boolean)
                                {
                                    <RadzenDropDown TValue="bool" Name="BooleanValue" Value="@VariableModel.BooleanValue" ValueChanged="@(value => VariableModel.BooleanValue = value)"
                                                    Data=@BoolOptions Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                                else if (VariableModel.VariableType == SimulatorDataTypes.Byte)
                                {
                                    <RadzenNumeric TValue="byte" Name="NumericValue" Value="@Convert.ToByte(VariableModel.NumericValue)" ValueChanged="@(value => VariableModel.NumericValue = value)"
                                                   Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                                else if (VariableModel.VariableType == SimulatorDataTypes.Double)
                                {
                                    <RadzenNumeric TValue="double" Name="NumericValue" Value="@Convert.ToDouble(VariableModel.NumericValue)" ValueChanged="@(value => VariableModel.NumericValue = value)"
                                                   Format="#0.00" Step="0.01" Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                                else if (VariableModel.VariableType == SimulatorDataTypes.Single)
                                {
                                    <RadzenNumeric TValue="float" Name="NumericValue" Value="@Convert.ToSingle(VariableModel.NumericValue)" ValueChanged="@(value => VariableModel.NumericValue = value)"
                                                   Format="#0.00" Step="0.01" Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                                else if (VariableModel.VariableType == SimulatorDataTypes.Int16)
                                {
                                    <RadzenNumeric TValue="short" Name="NumericValue" Value="@Convert.ToInt16(VariableModel.NumericValue)" ValueChanged="@(value => VariableModel.NumericValue = value)"
                                                   Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                                else if (VariableModel.VariableType == SimulatorDataTypes.Int32)
                                {
                                    <RadzenNumeric TValue="int" Name="NumericValue" Value="@Convert.ToInt32(VariableModel.NumericValue)" ValueChanged="@(value => VariableModel.NumericValue = value)"
                                                   Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                                else if (VariableModel.VariableType == SimulatorDataTypes.Int64)
                                {
                                    <RadzenNumeric TValue="long" Name="NumericValue" Value="@Convert.ToInt64(VariableModel.NumericValue)" ValueChanged="@(value => VariableModel.NumericValue = value)"
                                                   Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                                else if (VariableModel.VariableType == SimulatorDataTypes.UInt16)
                                {
                                    <RadzenNumeric TValue="ushort" Name="NumericValue" Value="@Convert.ToUInt16(VariableModel.NumericValue)" ValueChanged="@(value => VariableModel.NumericValue = value)"
                                                   Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                                else if (VariableModel.VariableType == SimulatorDataTypes.UInt32)
                                {
                                    <RadzenNumeric TValue="uint" Name="NumericValue" Value="@Convert.ToUInt32(VariableModel.NumericValue)" ValueChanged="@(value => VariableModel.NumericValue = value)"
                                                   Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                                else if (VariableModel.VariableType == SimulatorDataTypes.UInt64)
                                {
                                    <RadzenNumeric TValue="ulong" Name="NumericValue" Value="@Convert.ToUInt64(VariableModel.NumericValue)" ValueChanged="@(value => VariableModel.NumericValue = value)"
                                                   Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                                else if (VariableModel.VariableType == SimulatorDataTypes.String)
                                {
                                    <RadzenTextBox Name="NumericValue" Value="@Convert.ToString(VariableModel.StringValue)" ValueChanged="@(value => VariableModel.StringValue = value)"
                                                   Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                            }
                        </ChildContent>
                        <Helper>
                            @{
                                if (VariableModel.VariableType == Models.SimulatorDataTypes.Boolean)
                                {
                                    <RadzenRequiredValidator Component="BooleanValue" Text="Значение переменной обязательно" />
                                }
                                else
                                {
                                    <RadzenRequiredValidator Component="NumericValue" Text="Значение переменной обязательно" />
                                }
                            }
                        </Helper>
                    </RadzenFormField>
                </RadzenStack>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Stretch">
                <RadzenStack Gap="0">
                    <RadzenLabel>
                        Качество переменной
                    </RadzenLabel>
                    <RadzenFormField>
                        <RadzenDropDown @bind-Value="@VariableModel.StatusCode" Data="@QualityOptions" Style="width: 25rem" Disabled="@IsLoading" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenStack Gap="0">
                    <RadzenLabel>
                        Включить симуляцию
                    </RadzenLabel>
                    <RadzenFormField>
                        <RadzenDropDown @bind-Value="@VariableModel.Simulated" Data="@BoolOptions" Disabled="@IsLoading" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success" Visible="@(!IsLoading)">
                    Создать
                </RadzenButton>
                <RadzenButton Click="@(_ => DialogService.Close(true))" ButtonStyle="ButtonStyle.Dark" Visible="@(!IsLoading)">
                    Закрыть
                </RadzenButton>
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>
    <RadzenProgressBar Value="@ProgressBarValue" Visible="@IsLoading" ShowValue="true" />
</RadzenStack>

@code {
    [Parameter] public ServerOpcUa ServerOpcUa { get; set; }
    [Parameter] public IEnumerable<Type> DataTypes { get; set; }
    [Parameter] public IEnumerable<StatusCode> QualityOptions { get; set; }

    private const string OPC_STYLE = "width: 10rem";
    private List<bool> BoolOptions { get; } = [true, false];
    private NodeStateModel VariableModel { get; } = new();
    public double ProgressBarValue { get; private set; }
    public bool IsLoading { get; private set; }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        ServerOpcUa.ProgressBarEvent += ValueChanged;
    }

    private async Task ValueChanged(int value, bool isLoading)
    {
        ProgressBarValue = value;
        IsLoading = isLoading;
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddVariable(NodeStateModel model)
    {
        await ServerOpcUa.AddVariable(model);
        IsLoading = false;
        await InvokeAsync(StateHasChanged);
    }
}
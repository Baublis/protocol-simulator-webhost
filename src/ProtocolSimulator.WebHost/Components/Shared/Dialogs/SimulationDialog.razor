@using Orientation = Radzen.Orientation

@inject DialogService DialogService

<RadzenStack Gap="1rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
    <RadzenTemplateForm TItem="SimulationSettingsModel" Data="@SimulationSettingsModelEdited">
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenStack Gap="0" Visible="false">
                    <RadzenLabel>Изменений за период, шт.</RadzenLabel>
                    <RadzenFormField>
                        <RadzenNumeric @bind-Value="@SimulationSettingsModelEdited.NumberChanges" Min="1" Max="20000" />
                    </RadzenFormField>
                </RadzenStack>
                <RadzenStack Gap="0">
                    <RadzenLabel>Период изменений, с</RadzenLabel>
                    <RadzenFormField>
                        <RadzenNumeric @bind-Value="@SimulationSettingsModelEdited.TimeChanges" Min="1" Max="1000" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenStack Gap="0">
                    <RadzenLabel>Минимальное значение</RadzenLabel>
                    <RadzenFormField>
                        <RadzenNumeric @bind-Value="@SimulationSettingsModelEdited.LowerValue" Max="@(SimulationSettingsModelEdited.UpperValue - 1)" />
                    </RadzenFormField>
                </RadzenStack>
                <RadzenStack Gap="0">
                    <RadzenLabel>Максимальное значение</RadzenLabel>
                    <RadzenFormField>
                        <RadzenNumeric @bind-Value="@SimulationSettingsModelEdited.UpperValue" Min="@(SimulationSettingsModelEdited.LowerValue + 1)" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenButton ButtonType="ButtonType.Submit" Click="SaveModel" ButtonStyle="ButtonStyle.Success">
                    Сохранить
                </RadzenButton>
                <RadzenButton Click="@((args) => DialogService.Close(true))" ButtonStyle="ButtonStyle.Dark">
                    Закрыть
                </RadzenButton>
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenStack>

@code {
    [Parameter] public ISimulationService SimulationService { get; set; }

    [Parameter] public SimulationSettingsModel SimulationSettingsModel { get; set; }

    private SimulationSettingsModel SimulationSettingsModelEdited { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        SimulationSettingsModelEdited.LowerValue = SimulationSettingsModel.LowerValue;
        SimulationSettingsModelEdited.UpperValue = SimulationSettingsModel.UpperValue;
        SimulationSettingsModelEdited.NumberChanges = SimulationSettingsModel.NumberChanges;
        SimulationSettingsModelEdited.TimeChanges = SimulationSettingsModel.TimeChanges;
    }

    private void SaveModel()
    {
        SimulationService.SaveSimulationSettings(SimulationSettingsModelEdited);
        DialogService.Close(true);
    }

}
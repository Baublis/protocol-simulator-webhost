@using Orientation = Radzen.Orientation

@inject DialogService DialogService
@inject ServerService ServerService

<RadzenStack Gap="1rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%; min-width: 450px;">
    <RadzenTemplateForm TItem="DuplicateSettingsModel" Data="DuplicateSettings" Submit="DuplicateServer">
        <RadzenStack Gap="1.5rem">
            
            <!-- Информация об исходном сервере -->
            <RadzenCard Variant="Variant.Flat" Style="background: rgba(255,255,255,0.05); padding: 1rem;">
                <RadzenStack Gap="0.5rem">
                    <RadzenLabel Style="font-size:larger; font-weight:bold; color: var(--rz-primary); display: flex; align-items: center;">
                        <RadzenIcon Icon="@GetServerIcon()" Style="margin-right: 8px;" />
                        <span>Дублирование @GetServerTypeName()</span>
                    </RadzenLabel>
                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenText TextStyle="TextStyle.Body1">
                            <strong>Исходный сервер:</strong> @SourceServer?.Name
                        </RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1">
                            <strong>Порт:</strong> @SourceServer?.Port
                        </RadzenText>
                    </RadzenStack>

                    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                        <RadzenText TextStyle="TextStyle.Body1">
                            <RadzenLabel>@GetVariableLabel():</RadzenLabel> @SourceServer?.VariableCount
                        </RadzenText>
                        <RadzenStack Orientation="Orientation.Horizontal" Gap="0.25rem" AlignItems="AlignItems.Center">
                            <RadzenLabel>Статус:</RadzenLabel>
                            <span class="status-dot @GetStatusClass()" style="display: inline-block; margin-right: 4px;"></span>
                            <RadzenText Text="@GetStatusText()" TextStyle="TextStyle.Body1" />
                        </RadzenStack>
                    </RadzenStack>
                    @if (SourceServer?.IsSimulating == true)
                    {
                        <RadzenBadge BadgeStyle="BadgeStyle.Warning" Variant="Variant.Flat">
                            <RadzenIcon Icon="play_circle" Style="font-size: 14px; margin-right: 4px;" />
                            Симуляция запущена
                        </RadzenBadge>
                    }
                </RadzenStack>
            </RadzenCard>

            <!-- Количество копий -->
            <RadzenStack Gap="0.25rem">
                <RadzenLabel>
                    <RadzenIcon Icon="content_copy" Style="margin-right: 4px;" />
                    Количество копий
                </RadzenLabel>
                <RadzenFormField>
                    <ChildContent>
                        <RadzenNumeric @bind-Value="@DuplicateSettings.CopyCount" 
                                       Min="1" Max="25" 
                                       Step="1"
                                       Style="width: 100%;"
                                       Disabled="@IsLoading" />
                    </ChildContent>
                    <Helper>
                        <RadzenText Text="Пользуйтесь с умом. Каждый сервер тратит много ОЗУ." TextStyle="TextStyle.Caption" />
                    </Helper>
                </RadzenFormField>
            </RadzenStack>

            <!-- Настройки портов -->
            <RadzenStack Gap="1rem">
                <CheckboxWithLabel @bind-Value="@DuplicateSettings.AutoAssignPorts"
                                   LabelText="Автоматически подбирать свободные порты"
                                   Disabled="@IsLoading" />
                
                <RadzenStack Gap="0.25rem" Style="@(DuplicateSettings.AutoAssignPorts ? "opacity: 0.5;" : "")">
                    <RadzenLabel>
                        Начальный порт для первой копии
                    </RadzenLabel>
                    <RadzenFormField>
                        <ChildContent>
                            <RadzenNumeric @bind-Value="@DuplicateSettings.StartPort" 
                                           Min="1" Max="65535"
                                           Style="width: 100%;"
                                           Disabled="@(IsLoading || DuplicateSettings.AutoAssignPorts)" />
                        </ChildContent>
                        <Helper>
                            <RadzenText Text="Порты будут назначаться последовательно и уникально" TextStyle="TextStyle.Caption" />
                        </Helper>
                    </RadzenFormField>
                </RadzenStack>
            </RadzenStack>

            <!-- Настройки копирования -->
            <RadzenStack Gap="0.75rem">
                <CheckboxWithLabel @bind-Value="@DuplicateSettings.CopyAddressSpace"
                                   LabelText="@GetAddressSpaceLabel()"
                                   Disabled="@IsLoading" />

                <CheckboxWithLabel @bind-Value="@DuplicateSettings.CopySimulationSettings"
                                   LabelText="Копировать настройки симуляции (интервал, диапазоны)"
                                   Disabled="@IsLoading" />

                <CheckboxWithLabel @bind-Value="@DuplicateSettings.CopySimulationVariables"
                                   LabelText="Копировать список переменных для симуляции"
                                   Disabled="@IsLoading" />
            </RadzenStack>

            <!-- Настройки именования -->
            <RadzenStack Gap="1rem">
                <RadzenStack Gap="0.25rem">
                    <RadzenLabel>
                        Префикс имени
                    </RadzenLabel>
                    <RadzenFormField>
                        <ChildContent>
                            <RadzenTextBox @bind-Value="@DuplicateSettings.NamePrefix" 
                                           Disabled="@IsLoading"
                                           Placeholder="Например: Копия" />
                        </ChildContent>
                        <Helper>
                            <RadzenText Text="Будет добавлен перед именем исходного сервера" TextStyle="TextStyle.Caption" />
                        </Helper>
                    </RadzenFormField>
                </RadzenStack>

                <CheckboxWithLabel @bind-Value="@DuplicateSettings.AddCopyNumber"
                                   LabelText="Добавлять номер копии к имени"
                                   Disabled="@IsLoading" />
            </RadzenStack>

            <!-- Кнопки действий -->
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" Style="margin-top: 1.5rem;">
                <RadzenButton ButtonType="ButtonType.Submit" 
                              ButtonStyle="ButtonStyle.Success" 
                              Visible="@(!IsLoading)"
                              Disabled="@IsLoading">
                    <RadzenIcon Icon="content_copy" Style="margin-right: 4px;" />
                    Создать @GetCopyWord()
                </RadzenButton>
                <RadzenButton Click="@(_ => DialogService.Close(false))" 
                              ButtonStyle="ButtonStyle.Dark" 
                              Visible="@(!IsLoading)"
                              Disabled="@IsLoading">
                    Отмена
                </RadzenButton>
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>

    <!-- Прогресс-бар -->
    @if (IsLoading)
    {
        <RadzenStack Gap="0.5rem" Style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--rz-border-color);">
            <RadzenText Text="@ProgressMessage" TextStyle="TextStyle.Subtitle2" />
            <RadzenProgressBar Value="@ProgressValue" 
                               ShowValue="true" 
                               Max="100"
                               Style="width: 100%;" />
            <RadzenText Text="@ProgressDetail" TextStyle="TextStyle.Caption" Style="color: var(--rz-text-secondary);" />
        </RadzenStack>
    }
</RadzenStack>

@code {
    [Parameter] public ServerModel SourceServer { get; set; } = default!;

    [Parameter] public EventCallback<DuplicateResult> OnDuplicate { get; set; }

    private DuplicateSettingsModel DuplicateSettings { get; set; } = new();

    // Прогресс
    private bool IsLoading { get; set; }

    private int ProgressValue { get; set; }

    private string ProgressMessage { get; set; } = "Подготовка к дублированию...";

    private string ProgressDetail { get; set; } = "";

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        // Устанавливаем начальный порт из исходного сервера
        if (SourceServer != null)
        {
            DuplicateSettings.StartPort = SourceServer.Port + 1;
        }
    }

    private async Task DuplicateServer(DuplicateSettingsModel settings)
    {
        try
        {
            IsLoading = true;
            ProgressValue = 0;
            ProgressMessage = "Начало дублирования...";

            var result = new DuplicateResult
            {
                SourceServer = SourceServer,
                CopyCount = settings.CopyCount,
                CreatedServerIds = new List<int>(),
                CreatedServerNames = new List<string>()
            };

            for (int i = 1; i <= settings.CopyCount; i++)
            {
                // Обновляем прогресс
                ProgressValue = (int)((double)i / settings.CopyCount * 100);
                ProgressMessage = $"Создание копии {i} из {settings.CopyCount}";
                ProgressDetail = $"Сервер: {GetCopyName(settings, i)}";

                await InvokeAsync(StateHasChanged);
                await Task.Delay(10); // Даем UI обновиться

                try
                {
                    // Создаем копию сервера
                    int newId = await CreateServerCopy(settings, i);

                    if (newId > 0)
                    {
                        result.CreatedServerIds.Add(newId);
                        result.CreatedServerNames.Add(GetCopyName(settings, i));
                    }
                }
                catch (Exception ex)
                {
                    ProgressDetail = $"Ошибка при создании копии {i}: {ex.Message}";
                    await InvokeAsync(StateHasChanged);
                    await Task.Delay(500);
                    // Продолжаем со следующей копией
                }
            }

            ProgressValue = 100;
            ProgressMessage = "Дублирование завершено!";
            ProgressDetail = $"Создано {result.CreatedServerIds.Count} из {settings.CopyCount} копий";

            await InvokeAsync(StateHasChanged);
            await Task.Delay(500);

            // Закрываем диалог и передаем результат
            DialogService.Close(result);
            await OnDuplicate.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            ProgressMessage = "Ошибка при дублировании";
            ProgressDetail = ex.Message;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(2000);
            DialogService.Close(null);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task<int> CreateServerCopy(DuplicateSettingsModel settings, int copyNumber)
    {
        int newId = 0;

        if (SourceServer.Type == ServerType.OpcUa)
        {
            // Создаем новый OPC UA сервер (порт будет назначен автоматически методом GetOpcPort)
            newId = await ServerService.CreateOpcUaServiceAsync();

            // Переименовываем
            var newModel = ServerService.OpcUaModels.FirstOrDefault(m => m.Id == newId);
            if (newModel != null)
            {
                newModel.Name = GetCopyName(settings, copyNumber);

                // Если не автоназначение портов, меняем порт
                if (!settings.AutoAssignPorts)
                {
                    int targetPort = settings.StartPort + copyNumber - 1;
                    // Проверяем, не занят ли порт
                    var opcPorts = ServerService.OpcUaModels.Select(m => m.Port).ToHashSet();
                    if (!opcPorts.Contains(targetPort))
                    {
                        newModel.Port = targetPort;
                    }
                }
            }

            // Копируем адресное пространство и настройки
            if (settings.CopyAddressSpace)
            {
                await ServerService.DuplicateOpcUaServer(SourceServer.Id, newId);

                // Копируем настройки симуляции
                if (settings.CopySimulationSettings)
                {
                    var (sourceService, _) = await ServerService.GetOpcUaServer(SourceServer.Id);
                    var (targetService, _) = await ServerService.GetOpcUaServer(newId);

                    if (sourceService != null && targetService != null)
                    {
                        targetService.SaveSimulationSettings(sourceService.SimulationSettings);

                        if (settings.CopySimulationVariables && settings.CopyAddressSpace)
                        {
                            // Копируем список переменных для симуляции
                            targetService.SimulationVariables.Clear();
                            foreach (var variable in sourceService.SimulationVariables.Values)
                            {
                                var targetVariable = targetService.Server.NodeManager?.RootFolder?.Variables
                                    .FirstOrDefault(v => v.Value.Name == variable.Name).Value;

                                if (targetVariable != null)
                                {
                                    targetService.SimulationVariables.TryAdd(targetVariable.NodeId, targetVariable);
                                }
                            }
                        }
                    }
                }
            }
        }
        else if (SourceServer.Type == ServerType.ModbusTcp)
        {
            // Создаем новый Modbus TCP сервер (порт будет назначен автоматически методом GetModbusPort)
            newId = await ServerService.CreateModbusServiceAsync();

            // Переименовываем и настраиваем
            var newModel = ServerService.ModbusModels.FirstOrDefault(m => m.Id == newId);
            if (newModel != null)
            {
                newModel.Name = GetCopyName(settings, copyNumber);

                // Копируем ModBusKp
                var sourceModel = ServerService.ModbusModels.FirstOrDefault(m => m.Id == SourceServer.Id);
                if (sourceModel != null)
                {
                    newModel.ModBusKp = sourceModel.ModBusKp;
                }

                // Если не автоназначение портов, меняем порт
                if (!settings.AutoAssignPorts)
                {
                    int targetPort = settings.StartPort + copyNumber - 1;
                    // Проверяем, не занят ли порт
                    var modbusPorts = ServerService.ModbusModels.Select(m => m.Port).ToHashSet();
                    if (!modbusPorts.Contains(targetPort))
                    {
                        newModel.Port = targetPort;
                    }
                }
            }

            // Копируем переменные и настройки
            if (settings.CopyAddressSpace)
            {
                await ServerService.DuplicateModbusServer(SourceServer.Id, newId);

                // Копируем настройки симуляции
                if (settings.CopySimulationSettings)
                {
                    var (sourceService, _) = await ServerService.GetModBusServer(SourceServer.Id);
                    var (targetService, _) = await ServerService.GetModBusServer(newId);

                    if (sourceService != null && targetService != null)
                    {
                        targetService.SaveSimulationSettings(sourceService.SimulationSettings);

                        if (settings.CopySimulationVariables && settings.CopyAddressSpace)
                        {
                            // Копируем список переменных для симуляции
                            targetService.SimulationVariables.Clear();
                            foreach (var variable in sourceService.SimulationVariables)
                            {
                                var targetVariable = targetService.Variables.Values
                                    .FirstOrDefault(v => v.Address == variable.Address);

                                if (targetVariable != null)
                                {
                                    targetService.SimulationVariables.Add(targetVariable);
                                }
                            }
                        }
                    }
                }
            }
        }

        return newId;
    }

    private string GetCopyName(DuplicateSettingsModel settings, int copyNumber)
    {
        if (settings.AddCopyNumber)
        {
            return $"{settings.NamePrefix} {SourceServer?.Name} ({copyNumber})";
        }
        else
        {
            return $"{settings.NamePrefix} {SourceServer?.Name}";
        }
    }

    private string GetCopyWord()
    {
        var count = DuplicateSettings.CopyCount;

        if (count % 10 == 1 && count % 100 != 11)
            return "копию";
        else if (count % 10 >= 2 && count % 10 <= 4 && (count % 100 < 10 || count % 100 >= 20))
            return "копии";
        else
            return "копий";
    }

    private string GetServerIcon()
    {
        return SourceServer?.Type == ServerType.OpcUa ? "settings_ethernet" : "lan";
    }

    private string GetServerTypeName()
    {
        return SourceServer?.Type == ServerType.OpcUa ? "OPC UA сервера" : "Modbus TCP сервера";
    }

    private string GetVariableLabel()
    {
        return SourceServer?.Type == ServerType.OpcUa ? "Переменные" : "Регистры";
    }

    private string GetAddressSpaceLabel()
    {
        return SourceServer?.Type == ServerType.OpcUa 
            ? "Копировать адресное пространство (переменные и каталоги)" 
            : "Копировать регистры";
    }

    private string GetStatusClass()
    {
        return SourceServer?.Status switch
        {
            ServerStatus.Running => "status-running",
            ServerStatus.Stopped => "status-stopped",
            ServerStatus.Error => "status-error",
            _ => "status-error"
        };
    }

    private string GetStatusText()
    {
        return SourceServer?.Status switch
        {
            ServerStatus.Running => "Запущен",
            ServerStatus.Stopped => "Остановлен",
            ServerStatus.Error => "Ошибка",
            _ => "Неизвестно"
        };
    }
}
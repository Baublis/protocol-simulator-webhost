@using Orientation = Radzen.Orientation

<RadzenStack Gap="1rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
    <RadzenTemplateForm TItem="NodeStateModel" Data=FolderModel Submit="OpcUaServer.AddFolder">
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenStack Gap="0">
                    <RadzenLabel>Имя каталога</RadzenLabel>
                    <RadzenFormField>
                        <ChildContent>
                            <RadzenTextBox Name="Name" @bind-Value=@FolderModel.Name />
                        </ChildContent>
                        <Helper>
                            <RadzenRequiredValidator Component="Name" Text="Имя каталога обязательно" />
                        </Helper>
                    </RadzenFormField>
                </RadzenStack>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
                <RadzenFormField>
                    <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success">
                        Создать
                    </RadzenButton>
                </RadzenFormField>
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>
</RadzenStack>

@code {
    [Parameter] public ServerOpcUa OpcUaServer { get; set; }

    private NodeStateModel FolderModel { get; } = new();

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
    }
}
@using Orientation = Radzen.Orientation

@inject DialogService DialogService

<RadzenStack Gap="1rem" Orientation="Orientation.Vertical" JustifyContent="JustifyContent.SpaceBetween" Style="height: 100%;">
    <RadzenTemplateForm TItem="ModbusVariableModel" Data="VariableModel" Submit="AddVariable">
        <RadzenStack Gap="1rem">
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenStack Gap="0">
                    <RadzenLabel>
                        Количество
                    </RadzenLabel>
                    <RadzenFormField>
                        <RadzenNumeric @bind-Value="@VariableModel.CloneCount" Min="1" Max="20000" Style="@OPC_STYLE" Disabled="@IsLoading" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenStack Gap="0">
                    <RadzenLabel>
                        Тип переменной
                    </RadzenLabel>
                    <RadzenFormField>
                        <RadzenDropDown TValue="Type" Value="@VariableModel.DataTypeNet" TextProperty="@nameof(Type.Name)" Data="@DataTypes"
                                        ValueChanged="@(value => VariableModel.DataTypeNet = value)" Disabled="@IsLoading" />
                    </RadzenFormField>
                </RadzenStack>
                <RadzenStack Gap="0">
                    <RadzenLabel>
                        Значение переменной
                    </RadzenLabel>
                    <RadzenFormField>
                        <ChildContent>
                            @{
                                if (VariableModel.DataTypeNet == SimulatorDataTypes.Double)
                                {
                                    <RadzenNumeric TValue="double" Name="Value" Value="@Convert.ToDouble(VariableModel.Value)" ValueChanged="@(value => VariableModel.Value = value)"
                                                   Format="#0.00" Step="0.01" Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                                else if (VariableModel.DataTypeNet == SimulatorDataTypes.Single)
                                {
                                    <RadzenNumeric TValue="float" Name="Value" Value="@Convert.ToSingle(VariableModel.Value)" ValueChanged="@(value => VariableModel.Value = value)"
                                                   Format="#0.00" Step="0.01" Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                                else if (VariableModel.DataTypeNet == SimulatorDataTypes.UInt16)
                                {
                                    <RadzenNumeric TValue="ushort" Name="Value" Value="@Convert.ToUInt16(VariableModel.Value)" ValueChanged="@(value => VariableModel.Value = value)"
                                                   Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                                else if (VariableModel.DataTypeNet == SimulatorDataTypes.UInt32)
                                {
                                    <RadzenNumeric TValue="uint" Name="Value" Value="@Convert.ToUInt32(VariableModel.Value)" ValueChanged="@(value => VariableModel.Value = value)"
                                                   Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                                else if (VariableModel.DataTypeNet == SimulatorDataTypes.UInt64)
                                {
                                    <RadzenNumeric TValue="ulong" Name="Value" Value="@Convert.ToUInt64(VariableModel.Value)" ValueChanged="@(value => VariableModel.Value = value)"
                                                   Style="@OPC_STYLE" Disabled="@IsLoading" />
                                }
                            }
                        </ChildContent>
                        <Helper>
                            @{
                                <RadzenRequiredValidator Component="Value" Text="Значение переменной обязательно" />
                            }
                        </Helper>
                    </RadzenFormField>
                </RadzenStack>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenStack Gap="0">
                    <RadzenLabel>
                        Включить симуляцию
                    </RadzenLabel>
                    <RadzenFormField>
                        <RadzenDropDown @bind-Value="@VariableModel.Simulated" Data="@BoolOptions" Disabled="@IsLoading" />
                    </RadzenFormField>
                </RadzenStack>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween">
                <RadzenButton ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Success" Visible="@(!IsLoading)">
                    Создать
                </RadzenButton>
                <RadzenButton Click="@(_ => DialogService.Close(true))" ButtonStyle="ButtonStyle.Dark" Visible="@(!IsLoading)">
                    Закрыть
                </RadzenButton>
            </RadzenStack>
        </RadzenStack>
    </RadzenTemplateForm>
    <RadzenProgressBar Value="@ProgressBarValue" Visible="@IsLoading" ShowValue="true" />
</RadzenStack>

@code {
    [Parameter] public ServerModBusTcp ServerModBusTcp { get; set; }
    [Parameter] public IEnumerable<Type> DataTypes { get; set; }

    private const string OPC_STYLE = "width: 10rem";
    private ModbusVariableModel VariableModel { get; } = new();
    public double ProgressBarValue { get; private set; }
    public bool IsLoading { get; private set; }
    private List<bool> BoolOptions { get; } = [true, false];

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        ServerModBusTcp.ProgressBarEvent += ValueChanged;
    }

    private async Task ValueChanged(int value, bool isLoading)
    {
        ProgressBarValue = value;
        IsLoading = isLoading;
        await InvokeAsync(StateHasChanged);
    }

    private async Task AddVariable(ModbusVariableModel model)
    {
        await ServerModBusTcp.AddVariable(model);
        IsLoading = false;
        await InvokeAsync(StateHasChanged);
    }
}
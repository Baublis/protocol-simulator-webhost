<label style="display: inline-flex; align-items: center; gap: @Gap; cursor: pointer; user-select: none; width: fit-content;">
    <RadzenCheckBox TValue="bool" @bind-Value="@Value" Disabled="@Disabled" />
    <span style="white-space: nowrap;">@LabelText</span>
</label>

@code {
    [Parameter]
    public bool Value { get; set; }

    [Parameter]
    public EventCallback<bool> ValueChanged { get; set; }

    [Parameter]
    public string LabelText { get; set; } = "";

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public string Gap { get; set; } = "0.5rem";
}
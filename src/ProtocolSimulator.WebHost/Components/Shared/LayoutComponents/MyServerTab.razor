@inject DialogService DialogService

<div class="sidebar-content">

    <!-- Кнопки управления коллекцией -->
    <div style="display: flex; gap: 4px; margin-bottom: 8px;">

        <!-- Запустить все серверы -->
        <RadzenButton Icon="play_arrow"
                      ButtonStyle="ButtonStyle.Primary"
                      Size="ButtonSize.ExtraSmall"
                      Click="StartAllServers"
                      Disabled="!Servers.Any(s => s.Status != ServerStatus.Running)"
                      title="Запустить все серверы"
                      Style="flex: 1;" />

        <!-- Остановить все серверы -->
        <RadzenButton Icon="stop"
                      ButtonStyle="ButtonStyle.Warning"
                      Size="ButtonSize.ExtraSmall"
                      Click="StopAllServers"
                      Disabled="!Servers.Any(s => s.Status == ServerStatus.Running)"
                      title="Остановить все серверы"
                      Style="flex: 1;" />

        <!-- Разделитель -->
        <div style="width: 1px; background: var(--border-dark); margin: 4px 0;"></div>

        <!-- Запустить все симуляции -->
        <RadzenButton Icon="play_circle"
                      ButtonStyle="ButtonStyle.Secondary"
                      Size="ButtonSize.ExtraSmall"
                      Click="StartAllSimulations"
                      Disabled="!Servers.Any(s => s.Status == ServerStatus.Running && !s.IsSimulating)"
                      title="Запустить все симуляции"
                      Style="flex: 1;" />

        <!-- Остановить все симуляции -->
        <RadzenButton Icon="stop_circle"
                      ButtonStyle="ButtonStyle.Dark"
                      Size="ButtonSize.ExtraSmall"
                      Click="StopAllSimulations"
                      Disabled="!Servers.Any(s => s.IsSimulating)"
                      title="Остановить все симуляции"
                      Style="flex: 1;" />

        <!-- Вертикальный сепаратор -->
        <MyVerticalSeparator Height="20" />

        <!-- Удалить все серверы -->
        <RadzenButton Icon="delete_sweep"
                      ButtonStyle="ButtonStyle.Danger"
                      Size="ButtonSize.ExtraSmall"
                      Click="ShowDeleteAllConfirmation"
                      Disabled="!Servers.Any()"
                      title="Удалить все серверы"
                      Style="flex: 1;" />
    </div>

    <!-- Кнопка добавления (всегда видна) -->
    <div class="add-server-btn" @onclick="OnAdd">
        <RadzenIcon Icon="add" />
        <span>@GetAddButtonText()</span>
    </div>

    @if (Servers.Any())
    {
        @foreach (var server in Servers)
        {
            <MyServerCard Server="server"
                          OnClick="OnSelect"
                          OnRemove="OnRemove"
                          OnStartStopServer="OnStartStopServer"
                          OnStartStopSimulate="OnStartStopSimulate"
                          OnDuplicate="OnDuplicate" />
        }
    }
    else
    {
        <!-- Сообщение об отсутствии серверов -->
        <div class="empty-state">
            <RadzenIcon Icon="@GetEmptyStateIcon()" Style="font-size: 48px; opacity: 0.3;" />
            <div style="margin-top: 12px; color: var(--rz-text-secondary); text-align: center;">
                @GetEmptyStateMessage()
            </div>
        </div>
    }

    <!-- Статистика -->
    <div class="sidebar-stats">
        <div class="stat-item">
            <span>@GetVariableLabel(): @Servers.Sum(s => s.VariableCount)</span>
        </div>
        <div class="stat-item">
            <span>Запущено серверов: @Servers.Count(s => s.Status == ServerStatus.Running)</span>
        </div>
        <div class="stat-item">
            <span>Запущено симуляторов: @Servers.Count(s => s.IsSimulating)</span>
        </div>
    </div>

</div>

@code {
    [Parameter] public List<ServerModel> Servers { get; set; } = new();
    [Parameter] public ServerType ServerType { get; set; }

    [Parameter] public EventCallback<ServerModel> OnSelect { get; set; }
    [Parameter] public EventCallback<ServerModel> OnRemove { get; set; }
    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public EventCallback<ServerModel> OnStartStopServer { get; set; }
    [Parameter] public EventCallback<ServerModel> OnStartStopSimulate { get; set; }
    [Parameter] public EventCallback<ServerModel> OnDuplicate { get; set; }

    // Массовые операции
    [Parameter] public EventCallback OnStartAllServers { get; set; }
    [Parameter] public EventCallback OnStopAllServers { get; set; }
    [Parameter] public EventCallback OnStartAllSimulations { get; set; }
    [Parameter] public EventCallback OnStopAllSimulations { get; set; }
    [Parameter] public EventCallback OnDeleteAllServers { get; set; }

    private async Task ShowDeleteAllConfirmation()
    {
        var serverCount = Servers.Count;
        var serverTypeName = ServerType == ServerType.OpcUa ? "OPC UA" : "Modbus TCP";
        var serverWord = GetServerWord(serverCount);

        var options = new ConfirmOptions
        {
            OkButtonText = "Да, удалить",
            CancelButtonText = "Отмена",
            Width = "450px",
            Draggable = true,
            CloseDialogOnEsc = true,
            CloseDialogOnOverlayClick = false
        };

        var confirmed = await DialogService.Confirm(
            message: $"Вы действительно хотите удалить все {serverTypeName} серверы ({serverCount} {serverWord})?",
            title: "Подтверждение удаления",
            options: options
        );

        if (confirmed == true)
        {
            await OnDeleteAllServers.InvokeAsync();
        }
    }

    private string GetServerWord(int count)
    {
        var lastDigit = count % 10;
        var lastTwoDigits = count % 100;

        if (lastTwoDigits >= 11 && lastTwoDigits <= 19)
            return "серверов";

        return lastDigit switch
        {
            1 => "сервер",
            2 or 3 or 4 => "сервера",
            _ => "серверов"
        };
    }

    private string GetVariableLabel() =>
        ServerType == ServerType.OpcUa ? "Переменные OPC UA" : "Регистры ModBus TCP";

    private string GetEmptyStateIcon() =>
        ServerType == ServerType.OpcUa ? "settings_ethernet" : "lan";

    private string GetEmptyStateMessage() =>
        ServerType == ServerType.OpcUa
            ? "OPC UA серверы не настроены"
            : "ModBus TCP серверы не настроены";

    private string GetAddButtonText() =>
        ServerType == ServerType.OpcUa
            ? "Добавить OPC UA сервер"
            : "Добавить Modbus сервер";

    private async Task StartAllServers() => await OnStartAllServers.InvokeAsync();
    private async Task StopAllServers() => await OnStopAllServers.InvokeAsync();
    private async Task StartAllSimulations() => await OnStartAllSimulations.InvokeAsync();
    private async Task StopAllSimulations() => await OnStopAllSimulations.InvokeAsync();
}
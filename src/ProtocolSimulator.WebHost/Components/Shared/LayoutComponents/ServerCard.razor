@inject NavigationManager Navigation

<div class="server-card @GetCardClass()" @onclick="ClickServer" style="cursor: pointer;">

    <div class="flex align-center justify-between gap-sm">

        <!-- Статус и информация -->
        <div class="flex align-center gap-md" style="flex: 1;">

            <!-- Иконка статуса -->
            <div class="server-status">
                <div class="status-dot @GetStatusClass()"></div>
                @if (Server.IsSimulating)
                {
                    <RadzenIcon Icon="play_circle" Style="color: #ff9800; font-size: 14px;"
                                title="Симуляция запущена" />
                }
            </div>

            <!-- Информация о сервере -->
            <div class="server-info">
                <div class="server-name">@Server.Name</div>
                <div class="server-meta">
                    Порт: @Server.Port •
                    @Server.VariableCount @(Server.Type == ServerType.OpcUa ? "переменных" : "регистров")
                </div>
            </div>

        </div>

        <!-- Кнопки управления -->
        <div class="flex align-center" style="gap: 15px">

            <RadzenButton Icon="@GetStartStopServerIcon()"
                          ButtonStyle="@GetStartStopServerButtonStyle()"
                          Size="ButtonSize.Small"
                          Click=StartStopServer
                          @onclick:stopPropagation="true"
                          title="@GetStartStopServerTitle()"
                          Disabled="Server.IsSimulating" />

            <RadzenButton Icon="@GetStartStopSimulatingIcon()"
                          ButtonStyle="@GetStartStopSimulatingButtonStyle()"
                          Size="ButtonSize.Small"
                          Click=StartStopSimulate
                          @onclick:stopPropagation="true"
                          title="@GetStartStopSimulatingButtonTitle()"
                          Disabled="Server.Status != ServerStatus.Running" />

            <RadzenButton Icon="content_copy"
                          ButtonStyle="ButtonStyle.Info"
                          Size="ButtonSize.Small"
                          Click="DuplicateServer"
                          @onclick:stopPropagation="true"
                          title="Дублировать сервер"
                          Disabled="Server.Status != ServerStatus.Running" />

            <RadzenButton Icon="delete"
                          ButtonStyle="ButtonStyle.Danger"
                          Size="ButtonSize.Small"
                          Click="RemoveServer"
                          @onclick:stopPropagation="true"
                          title="Удалить сервер" />
        </div>

    </div>

</div>

@code {
    [Parameter]
    public ServerModel Server { get; set; } = default!;

    [Parameter]
    public EventCallback<ServerModel> OnClick { get; set; }

    [Parameter]
    public EventCallback<ServerModel> OnRemove { get; set; }

    [Parameter]
    public EventCallback<ServerModel> OnStartStopServer { get; set; }

    [Parameter]
    public EventCallback<ServerModel> OnStartStopSimulate { get; set; }

    // НОВЫЙ ПАРАМЕТР: событие для дублирования
    [Parameter]
    public EventCallback<ServerModel> OnDuplicate { get; set; }

    private bool IsRunningServer()
    {
        var result = Server.Status == ServerStatus.Running;
        return result;
    }

    private bool IsSimulating()
    {
        return Server.IsSimulating;
    }

    private string GetCardClass()
    {
        var result = Server.Status switch
        {
            ServerStatus.Running => "running",
            ServerStatus.Stopped => "stopped",
            ServerStatus.Error => "error",
            _ => "error"
        };

        Console.WriteLine($"Server Status: {Server.Status}, Card Class: {result}");
        return result;
    }

    private string GetStatusClass()
    {
        return Server.Status switch
        {
            ServerStatus.Running => "status-running",
            ServerStatus.Stopped => "status-stopped",
            ServerStatus.Error => "status-error",
            _ => "status-error"
        };
    }

    private string GetStartStopServerIcon()
    {
        return IsRunningServer() ? "stop" : "play_arrow";
    }

    private string GetStartStopServerTitle()
    {
        return IsRunningServer() ? "Остановить сервер" : "Запустить сервер";
    }

    private ButtonStyle GetStartStopServerButtonStyle()
    {
        return IsRunningServer() ? ButtonStyle.Success : ButtonStyle.Primary;
    }

    private string GetStartStopSimulatingIcon()
    {
        return IsSimulating() ? "stop" : "play_arrow";
    }

    private string GetStartStopSimulatingButtonTitle()
    {
        return IsSimulating() ? "Остановить симуляцию" : "Запустить симуляцию";
    }

    private ButtonStyle GetStartStopSimulatingButtonStyle()
    {
        return IsSimulating() ? ButtonStyle.Dark : ButtonStyle.Secondary;
    }

    private async Task ClickServer()
    {
        await OnClick.InvokeAsync(Server);
    }

    private async Task RemoveServer()
    {
        await OnRemove.InvokeAsync(Server);
    }

    // НОВЫЙ МЕТОД: обработчик дублирования
    private async Task DuplicateServer()
    {
        await OnDuplicate.InvokeAsync(Server);
    }

    private async Task StartStopServer()
    {
        await OnStartStopServer.InvokeAsync(Server);
    }

    private async Task StartStopSimulate()
    {
        await OnStartStopSimulate.InvokeAsync(Server);
    }
}